rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{uid} {
      // Users can read their own doc, admins can read any user doc
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Users can create their own doc (registration) — role must be "user" or absent
      allow create: if request.auth != null && request.auth.uid == uid
        && (!("role" in request.resource.data) || request.resource.data.role == "user");
      // Users can update their own doc but NEVER change the role field
      allow update: if (request.auth != null && request.auth.uid == uid
        && (!("role" in request.resource.data) || request.resource.data.role == resource.data.role))
        || isAdmin();
      // Users can delete their own doc, admins can delete any
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    match /usernames/{username} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /quizResults/{uid} {
      // Owner can read/write, admins can read any
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Test questions — any authenticated user can read, no client writes
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-user test history — owner can read/write, admins can read any
    match /testHistory/{uid}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin audit log — append-only, admins can read and create but never modify or delete
    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.timestamp == request.time;
    }

    // Collection group rule for test history sessions
    match /{path=**}/sessions/{sessionId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // AI rate limit — only Cloud Function (admin SDK) writes, users can read their own
    match /aiRateLimit/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
