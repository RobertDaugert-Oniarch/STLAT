rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Registered (email/password) user — excludes anonymous
    function isRegistered() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Anonymous (guest) user
    function isAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── Users — registered only, anonymous blocked ──

    match /users/{uid} {
      allow read: if isRegistered() && (isOwner(uid) || isAdmin());
      allow create: if isRegistered() && isOwner(uid)
        && (!("role" in request.resource.data) || request.resource.data.role == "user");
      allow update: if (isRegistered() && isOwner(uid)
        && (!("role" in request.resource.data) || request.resource.data.role == resource.data.role))
        || isAdmin();
      allow delete: if (isRegistered() && isOwner(uid)) || isAdmin();
    }

    // ── Usernames — registered only, anonymous blocked ──

    match /usernames/{username} {
      allow read:   if isRegistered();
      allow create: if isRegistered()
                    && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isRegistered()
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ── Quiz Results — validated writes ──

    match /quizResults/{uid} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());

      // Registered users: full write to own doc
      allow write: if isRegistered() && isOwner(uid);

      // Anonymous users: validated create with isAnonymous flag
      allow create: if isAnon() && isOwner(uid)
        && request.resource.data.isAnonymous == true
        && request.resource.data.percentage is int
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.total == 100;

      // Anonymous users: can only update own anonymous doc
      allow update: if isAnon() && isOwner(uid)
        && request.resource.data.isAnonymous == true
        && resource.data.isAnonymous == true;

      // Admins can delete any quiz result (user cleanup)
      allow delete: if isAdmin();
    }

    // ── Test questions — any authenticated user can read, no client writes ──

    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Per-user test history — validated anonymous writes ──

    match /testHistory/{uid}/{document=**} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());

      // Registered users: full write
      allow write: if isRegistered() && isOwner(uid);

      // Anonymous users: validated create only (no update/delete)
      allow create: if isAnon() && isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isAnonymous == true
        && request.resource.data.overallPercentage is int
        && request.resource.data.overallPercentage >= 0
        && request.resource.data.overallPercentage <= 100;

      // Admins can delete any test history (user cleanup)
      allow delete: if isAdmin();
    }

    // ── Admin audit log — append-only ──

    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.timestamp == request.time;
    }

    // ── Collection group: sessions — read-only, no client writes ──
    // Writes go through testHistory/{uid}/{document=**} above

    match /{path=**}/sessions/{sessionId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Guest demographics — validated anonymous create only ──

    match /guestDemographics/{uid} {
      allow create: if isAnon() && isOwner(uid)
        && request.resource.data.keys().hasAll(['age', 'gender', 'country', 'education', 'occupation', 'createdAt'])
        && request.resource.data.keys().size() == 6
        && request.resource.data.age is string
        && request.resource.data.gender is string
        && request.resource.data.country is string
        && request.resource.data.education is string
        && request.resource.data.occupation is string
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── AI rate limit — Cloud Function only ──

    match /aiRateLimit/{uid} {
      allow read: if request.auth != null && isOwner(uid);
      allow write: if false;
    }

    // ── Lectures — any authenticated user can read, admin writes ──

    match /lectures/{lectureId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Per-user lecture progress — owner only ──

    match /lectureProgress/{uid}/items/{docId} {
      allow read, write: if request.auth != null && isOwner(uid);
    }
  }
}
